run = "npm start"
modules = ["nodejs-20", "postgresql-16", "python-3.11"]
[nix]
channel = "stable-24_05"
packages = ["gitFull", "playwright-driver"]

[deployment]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start Reality Check Server"
author = 42214058
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Game Server"

[[workflows.workflow]]
name = "Game Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node game-server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
